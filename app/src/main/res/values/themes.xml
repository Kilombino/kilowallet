<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PyBlockWatch" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>
    <!-- The converter opens over the home screen from the widget, as a dialog. -->
    <style name="Theme.PyBlockWatch.Converter" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
</resources>
