<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xbt_widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/xbt_coin"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="22sp"
            android:text="–"
            android:textColor="@color/widget_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
        <!-- Big touch target (48 dp) around a small arrow; the negative margins keep the
             header row as tall as before. While refreshing, the arrow spins. -->
        <FrameLayout
            android:id="@+id/refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="-12dp"
            android:layout_marginEnd="-10dp"
            android:contentDescription="@string/xbtw_refresh">
            <ImageView
                android:id="@+id/refresh_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/xbt_ic_refresh"
                android:contentDescription="@null" />
            <ProgressBar
                android:id="@+id/refresh_spin"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/xbt_refresh_spin"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
